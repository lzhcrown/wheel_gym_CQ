# Local Python environments and package caches
/.venv*/
/venv/
/env/
/.uv-cache/
/.cache/

# Training logs, generated data, videos and exported policies
/logs/
/videos/
/runs/
/wandb/
/exports/
/data/
/evaluations/
# Also cover event files and console logs outside the default output folders.
events.out.tfevents.*
*.log
*.pt
*.pth
*.ckpt
*.onnx

# Python bytecode, build products and test/tool caches
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
/htmlcov/

# Machine-specific editor settings and temporary files
/.vscode/
/.idea/
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Local cloud credentials and Codex session state
/.aws/
/.codex/

# Local environment variables; keep shareable examples
.env
.env.*
!.env.example

# Keep source/configuration files, scripts, tests, dependency locks and docs.
# Keep resources/, including URDF, meshes (STL/OBJ/etc.), textures and JSON/YAML.
# Keep artifacts/evaluation_terrain/ as shareable terrain illustrations.
# Keep AGENTS.md and .agents/ if shared project instructions/skills are added.
# Do not add blanket exclusions for *.json, *.csv or robot asset formats.
